# Agency OS Environment Configuration
# Mac Studio M4 MAX (128GB) - Optimized Configuration

# =============================================================================
# CORE SETTINGS
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here
AGENCY_MODEL=gpt-5

# =============================================================================
# LOCAL MODEL CONFIGURATION (96% Cost Reduction)
# =============================================================================
USE_LOCAL_MODEL=true
LOCAL_MODEL_NAME=hf.co/abirhossen/Qwen3-Coder-30B-A3B-Instruct-Q8_0-GGUF:Q8_0
LOCAL_MODEL_TEST_WORKERS=20  # Mac Studio 128GB: aggressive parallelism

# Model Routing:
# - P3 (simple): 60% of tasks → $0 (local Qwen3-Coder 30B Q8_0)
# - P2 (moderate): 30% of tasks → $1.50/1M (gpt-4o)
# - P1 (complex): 10% of tasks → $4.00/1M (gpt-5)

# =============================================================================
# PER-AGENT MODEL OVERRIDES (Optional)
# =============================================================================
PLANNER_MODEL=gpt-5                   # Strategic planning
CODER_MODEL=gpt-5                     # Implementation
AUDITOR_MODEL=gpt-5                   # Quality analysis
QUALITY_ENFORCER_MODEL=gpt-5          # Constitutional compliance
SUMMARY_MODEL=gpt-5-mini              # Cost-efficient summaries

# =============================================================================
# MEMORY & LEARNING (MANDATORY - Article IV)
# =============================================================================
USE_ENHANCED_MEMORY=true              # Constitutional requirement
FRESH_USE_FIRESTORE=false             # Local VectorStore only

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
FORCE_RUN_ALL_TESTS=1                 # Enable full 6,246 test suite
PYTEST_WORKERS=20                     # Match LOCAL_MODEL_TEST_WORKERS

# =============================================================================
# APPLE SILICON OPTIMIZATION (Mac Studio M4 MAX)
# =============================================================================
# Memory: 128GB unified (70GB available for Ollama + tests)
# Recommended: Qwen3-Coder 30B Q8_0 (32GB) + 20 test workers (38GB) = 70GB
# Alternative: Qwen3-Coder 70B Q4 (44GB) + 10 test workers (26GB) = 70GB

# KV Cache Optimization (2025 Ollama update)
OLLAMA_KV_CACHE_TYPE=q8_0             # 2x memory savings vs f16
OLLAMA_FLASH_ATTENTION=1              # Enable flash attention
OLLAMA_NUM_THREADS=16                 # Match M4 MAX cores

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
DEBUG_MODE=false
LOG_LEVEL=INFO

# =============================================================================
# COST TRACKING
# =============================================================================
DAILY_BUDGET_USD=100.0                # Daily spending limit
PER_MISSION_BUDGET_USD=10.0           # Per-mission limit

# Expected monthly cost with Mac Studio 128GB:
# ~$1.2K/month (97% reduction vs all-cloud gpt-5)

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================
# GitHub CLI (for PR creation)
# gh auth login

# Anthropic API (for cross-provider fallback)
# ANTHROPIC_API_KEY=your_anthropic_key_here

# =============================================================================
# NOTES
# =============================================================================
# 1. Copy this file to .env: cp .env.mac_studio .env
# 2. Replace placeholder API keys
# 3. Adjust PYTEST_WORKERS if running smaller models
# 4. Monitor memory usage: docker stats agency-ollama (if using Docker)
# 5. Full test suite should complete in <15 min (vs 25-30 min on M4 Pro 48GB)
