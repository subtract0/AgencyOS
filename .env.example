# Agency OS Environment Configuration
# Copy this file to .env and fill in your values

# REQUIRED: OpenAI API Configuration
OPENAI_API_KEY=your_api_key_here

# Model Configuration (Updated 2025-11-05 for actual system)
# CURRENT CONFIG (100% local, $0 cost):
AGENCY_MODEL=vcoder-120b-1.0-qx86-hi-mlx           # ALL agents use this model (120B params)
PLANNER_MODEL=vcoder-120b-1.0-qx86-hi-mlx
CODER_MODEL=vcoder-120b-1.0-qx86-hi-mlx
AUDITOR_MODEL=vcoder-120b-1.0-qx86-hi-mlx
QUALITY_ENFORCER_MODEL=vcoder-120b-1.0-qx86-hi-mlx
SUMMARY_MODEL=vcoder-120b-1.0-qx86-hi-mlx
GATEKEEPER_MODEL=vcoder-120b-1.0-qx86-hi-mlx
ALCHEMIST_MODEL=vcoder-120b-1.0-qx86-hi-mlx

# Remote LM Studio Server (NOT Ollama)
# OPENAI_API_BASE=http://YOUR_LM_STUDIO_IP:1234/v1  # Optional: Remote LM Studio endpoint

# Local Model Configuration (M4 Max 128GB)
USE_LOCAL_MODEL=true                                # Enable local model (Ollama or LM Studio)
LOCAL_MODEL_NAME=vcoder-120b-1.0-qx86-hi-mlx       # Model name (adjust for your setup)
LOCAL_MODEL_TEST_WORKERS=6                          # Conservative default (safe for race conditions)

# REALITY (verified 2025-11-05):
# - 100% vcoder-120b (remote LM Studio on 192.168.0.2)
# - NO tier routing (P1/P2/P3 code exists but disabled)
# - Cost: $0/month (100% local network)
# - Memory: ~30GB remote, 128GB local Mac Studio (massive headroom)
#
# OPTIONAL: Cloud API tier routing (currently DISABLED)
# To enable P1/P2/P3 routing, remove model overrides above and use:
# AGENCY_MODEL=gpt-5                    # Will trigger adaptive routing
# P3 (simple): Local → $0 (60% of tasks)
# P2 (moderate): gpt-4o → $1.50/1M (30% of tasks)
# P1 (complex): gpt-5 → $4.00/1M (10% of tasks)
#
# Hardware: M4 Max 128GB Mac Studio (NOT M4 Pro 48GB)
# - 12-core CPU, 16-core GPU, 128GB unified memory
# - Memory budget: 20 workers (60GB) + model (30GB remote) + system (10GB) = 100GB / 128GB
# - No memory pressure concerns
# See: docs/HARDWARE_OPTIMIZATION.md for M4 Max optimizations

# Memory & Learning Configuration
USE_ENHANCED_MEMORY=true              # Enable VectorStore integration (semantic search)
FRESH_USE_FIRESTORE=true              # Use Firestore for persistent memory (recommended for production)
PERSIST_PATTERNS=true                 # Persist learned patterns

# Firestore Configuration (required if FRESH_USE_FIRESTORE=true)
GOOGLE_APPLICATION_CREDENTIALS=./path/to/firebase-credentials.json  # Path to Firebase service account JSON
# GOOGLE_CLOUD_PROJECT=your-project-id  # Optional: Firebase project ID (auto-detected from credentials)

# Testing Configuration
FORCE_RUN_ALL_TESTS=0                 # Set to 1 to force all tests to run
AGENCY_SKIP_GIT=0                     # Set to 1 to skip git-related tests
AGENCY_TEST_TIMEOUT_OVERRIDE=600      # Test timeout in seconds

# Development Configuration
ENABLE_UNIFIED_CORE=true              # Enable unified core system
USE_PARALLEL_AUDIT=false              # Enable parallel auditing
ENABLE_AUTO_ROLLBACK=true             # Enable automatic rollback on failures

# Logging Configuration
LOG_LEVEL=INFO                        # DEBUG, INFO, WARNING, ERROR
ENABLE_TELEMETRY=true                 # Enable telemetry logging

# Optional: Firebase Configuration (if using Firestore)
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CREDENTIALS_PATH=./path/to/credentials.json

# Optional: GitHub Integration
# GITHUB_TOKEN=your_github_token
# GITHUB_REPO=owner/repo

# Optional: External Services
# ANTHROPIC_API_KEY=your_anthropic_key
# FIRECRAWL_API_KEY=your_firecrawl_key

# ElevenLabs TTS Configuration (for audio summaries)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
