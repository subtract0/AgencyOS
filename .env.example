# Agency OS Environment Configuration
# Copy this file to .env and fill in your values

# REQUIRED: OpenAI API Configuration
OPENAI_API_KEY=your_api_key_here

# Model Configuration (defaults shown)
AGENCY_MODEL=gpt-5                    # Primary model for all agents
PLANNER_MODEL=gpt-5                   # Planner agent specific override
CODER_MODEL=gpt-5                     # Code agent specific override
AUDITOR_MODEL=gpt-5                   # Auditor agent specific override
QUALITY_ENFORCER_MODEL=gpt-5          # Quality enforcer specific override
SUMMARY_MODEL=gpt-5-mini              # Summary agent (can use smaller model)

# Local Model Configuration (Phase 3: 96% cost reduction)
# Enables local Ollama models for P3 simple tasks (60% of workload)
USE_LOCAL_MODEL=true                                                    # Enable local models for P3 tasks (default: true)
LOCAL_MODEL_NAME=qwen3-coder:30b                                        # Official Ollama model (Q4_K_M, 19GB, optimized)
LOCAL_MODEL_TEST_WORKERS=3                                              # Test workers when local model active (default: 3, prevents memory exhaustion)
# P3 (simple): Fix typos, format code, remove unused imports → $0 (local)
# P2 (moderate): Feature implementation, bug fixes → gpt-4o ($1.50/1M)
# P1 (complex): Architecture, ADRs, critical systems → gpt-5 ($4.00/1M)
#
# Apple Silicon Optimization (2025):
# - Official model with Metal GPU support
# - KV cache quantization: Set OLLAMA_KV_CACHE_TYPE="q8_0" (2x memory savings)
# - Flash attention: Set OLLAMA_FLASH_ATTENTION=1 (faster inference)
# Memory budget (48GB Mac): 19GB (model) + 16GB (KV Q8_0) + 9GB (3 workers) = 44GB (safe)
# See: docs/LOCAL_MODEL_OPTIMIZATION.md for setup instructions

# Memory & Learning Configuration
USE_ENHANCED_MEMORY=true              # Enable VectorStore integration (semantic search)
FRESH_USE_FIRESTORE=true              # Use Firestore for persistent memory (recommended for production)
PERSIST_PATTERNS=true                 # Persist learned patterns

# Firestore Configuration (required if FRESH_USE_FIRESTORE=true)
GOOGLE_APPLICATION_CREDENTIALS=./path/to/firebase-credentials.json  # Path to Firebase service account JSON
# GOOGLE_CLOUD_PROJECT=your-project-id  # Optional: Firebase project ID (auto-detected from credentials)

# Testing Configuration
FORCE_RUN_ALL_TESTS=0                 # Set to 1 to force all tests to run
AGENCY_SKIP_GIT=0                     # Set to 1 to skip git-related tests
AGENCY_TEST_TIMEOUT_OVERRIDE=600      # Test timeout in seconds

# Development Configuration
ENABLE_UNIFIED_CORE=true              # Enable unified core system
USE_PARALLEL_AUDIT=false              # Enable parallel auditing
ENABLE_AUTO_ROLLBACK=true             # Enable automatic rollback on failures

# Logging Configuration
LOG_LEVEL=INFO                        # DEBUG, INFO, WARNING, ERROR
ENABLE_TELEMETRY=true                 # Enable telemetry logging

# Optional: Firebase Configuration (if using Firestore)
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CREDENTIALS_PATH=./path/to/credentials.json

# Optional: GitHub Integration
# GITHUB_TOKEN=your_github_token
# GITHUB_REPO=owner/repo

# Optional: External Services
# ANTHROPIC_API_KEY=your_anthropic_key
# FIRECRAWL_API_KEY=your_firecrawl_key

# ElevenLabs TTS Configuration (for audio summaries)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here