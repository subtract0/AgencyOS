# ===========================================
# CLOUD MODE (default) - Uses OpenAI
# ===========================================
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ===========================================
# LOCAL MODE - Uses vcoder-120b on LM Studio
# ===========================================
# Set to 'true' to use local model (free, no API key needed)
USE_LOCAL_MODEL=false

# Local model server (LM Studio default)
LOCAL_API_BASE=http://localhost:1234/v1
LOCAL_MODEL=vcoder-120b-1.0-hi-mlx
